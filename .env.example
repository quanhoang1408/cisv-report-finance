# Sao chép thành .env.local (local) hoặc khai báo trong Vercel → Settings → Environment Variables.
# Bỏ trống cả hai → app chạy hoàn toàn local, không có tính năng xuất bản cho phụ huynh.
# Chỉ dùng publishable/anon key. KHÔNG BAO GIỜ đặt secret/service_role key ở đây.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
